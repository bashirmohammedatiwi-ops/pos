<Window x:Class="FOT.Pos.ServerHost.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOT POS — الخادم الرئيسي"
        Height="560" Width="580"
        MinHeight="500" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        Background="#F1F5F9"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI, Tahoma">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border DockPanel.Dock="Right" Width="48" Height="48" CornerRadius="12" Background="#1E3A8A">
                <TextBlock Text="FOT" Foreground="White" FontWeight="Bold" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel>
                <TextBlock Text="FOT POS Server" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock x:Name="VersionText" Text="الخادم الرئيسي" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#F59E0B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Text="جاري التشغيل…" FontSize="16" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ModeText" Text="" FontSize="12" Foreground="#64748B" Margin="22,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="عناوين الاتصال" FontWeight="SemiBold" FontSize="14"/>
                    <Button DockPanel.Dock="Left" Content="تحديث" Padding="10,4" Margin="8,0,0,0"
                            Click="Refresh_Click" Background="#F1F5F9" BorderBrush="#E2E8F0" Cursor="Hand"/>
                </DockPanel>
                <TextBlock Text="على هذا الجهاز:" Foreground="#64748B" FontSize="12"/>
                <DockPanel Margin="0,4,0,12">
                    <Button DockPanel.Dock="Left" Content="نسخ" Padding="10,6" Margin="8,0,0,0"
                            Click="CopyLocal_Click" Background="#EFF6FF" Foreground="#1D4ED8" BorderThickness="0" Cursor="Hand"/>
                    <TextBox x:Name="LocalUrlBox" IsReadOnly="True" Padding="8,6" Background="#F8FAFC" BorderBrush="#E2E8F0"/>
                </DockPanel>
                <TextBlock Text="للأجهزة الأخرى (Ethernet):" Foreground="#64748B" FontSize="12"/>
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Left" Content="نسخ" Padding="10,6" Margin="8,0,0,0"
                            VerticalAlignment="Top" Click="CopyLan_Click" Background="#EFF6FF" Foreground="#1D4ED8" BorderThickness="0" Cursor="Hand"/>
                    <TextBox x:Name="LanUrlBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             MinHeight="72" MaxHeight="110" VerticalScrollBarVisibility="Auto"
                             Padding="8,6" Background="#F8FAFC" BorderBrush="#E2E8F0"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="OpenAdminBtn" Content="لوحة التحكم" Padding="16,10" Margin="0,0,8,8"
                    Click="OpenAdmin_Click" Background="#1E3A8A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="نقطة البيع" Padding="16,10" Margin="0,0,8,8"
                    Click="OpenClient_Click" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="RestartBtn" Content="إعادة تشغيل" Padding="16,10" Margin="0,0,8,8"
                    Click="Restart_Click" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="إخفاء" Padding="16,10" Margin="0,0,0,8"
                    Click="HideToTray_Click" Background="#E2E8F0" Foreground="#334155" BorderThickness="0" Cursor="Hand"/>
        </WrapPanel>

        <TextBlock Grid.Row="4" Text="الخادم يستمر بالعمل في شريط المهام حتى بعد إغلاق هذه النافذة."
                   FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
    </Grid>
</Window>
