<UserControl x:Class="FOT.Pos.Admin.Pages.CommissionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Style="{StaticResource FilterBar}" Padding="12,10">
            <StackPanel>
                <TextBlock Text="مجاميع العمولات" Style="{StaticResource H2}"/>
                <TextBlock Text="أضف منتجات متتالية بالباركود أو البحث — تبقى داخل المجموعة بعد كل إضافة"
                           Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DataPanel}">
                <DockPanel Margin="12">
                    <Button DockPanel.Dock="Top" Content="+ مجموعة جديدة" Style="{StaticResource PrimaryButton}"
                            Margin="0,0,0,8" Click="NewGroup_Click"/>
                    <TextBox x:Name="GroupFilterBox" DockPanel.Dock="Top" Style="{StaticResource InputBox}"
                             Margin="0,0,0,8" TextChanged="GroupFilterBox_TextChanged"/>
                    <ListBox x:Name="GroupsList" DisplayMemberPath="Display"
                             SelectionChanged="GroupsList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="DetailPanel" Margin="0,0,0,12">
                        <Border Style="{StaticResource DataPanel}" Margin="0,0,0,10">
                            <Grid Margin="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="اسم المجموعة" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="GroupNameBox" Style="{StaticResource InputBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="د.ع / قطعة" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="GroupValueBox" Style="{StaticResource InputBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="مندوب (اختياري)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="GroupSalesmanCombo" DisplayMemberPath="Name"
                                              Style="{StaticResource InputComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="5" VerticalAlignment="Bottom" Orientation="Horizontal">
                                    <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Click="SaveGroup_Click" Margin="0,0,6,0"/>
                                    <Button Content="حذف" Style="{StaticResource GhostDangerButton}" Click="DeleteGroup_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource DataPanel}" Margin="0,0,0,10">
                            <StackPanel Margin="16">
                                <TextBlock Text="إضافة منتجات بسرعة" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                                <TabControl x:Name="AddModeTabs" SelectionChanged="AddModeTabs_SelectionChanged">
                                    <TabItem Header="باركود">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="امسح الباركود ثم Enter — تبقى في المجموعة" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox x:Name="BarcodeBox" Width="320" Style="{StaticResource InputBox}"
                                                         Margin="0,0,8,0" KeyDown="BarcodeBox_KeyDown"/>
                                                <Button Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                        Click="AddBarcode_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="بحث بالاسم">
                                        <StackPanel Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBox x:Name="ProductSearchBox" Width="280" Style="{StaticResource InputBox}"
                                                         Margin="0,0,8,0" KeyDown="ProductSearchBox_KeyDown"/>
                                                <Button Content="بحث" Style="{StaticResource SecondaryButton}"
                                                        Click="SearchProducts_Click"/>
                                            </StackPanel>
                                            <DataGrid x:Name="SearchResultsGrid" Height="160" IsReadOnly="True"
                                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                                      SelectionMode="Single" MouseDoubleClick="SearchResultsGrid_MouseDoubleClick">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="باركود" Binding="{Binding Barcode}" Width="120"/>
                                                    <DataGridTextColumn Header="السعر" Binding="{Binding OriginalPrice, StringFormat=N0}" Width="90"/>
                                                    <DataGridTemplateColumn Header="" Width="70">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="إضافة" Style="{StaticResource GhostButton}"
                                                                        Click="AddSearchProduct_Click" Tag="{Binding}"/>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                                <Button Content="+ إضافة شجرة كاملة" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="AddTree_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource DataPanel}">
                            <DockPanel Margin="16">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ContentTitle" Text="محتويات المجموعة"
                                               Style="{StaticResource H2}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="ContentFilterBox" Width="160"
                                                 Style="{StaticResource InputBox}" Margin="8,0,0,0"
                                                 TextChanged="ContentFilterBox_TextChanged"/>
                                        <ComboBox x:Name="MoveTargetCombo" Width="150" DisplayMemberPath="Name"
                                                  Style="{StaticResource InputComboBox}" Margin="8,0,6,0"/>
                                        <Button Content="نقل المحدد" Style="{StaticResource SecondaryButton}"
                                                Click="MoveSelected_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="ContentGrid" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserAddRows="False" HeadersVisibility="Column"
                                          SelectionMode="Extended">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="النوع" Binding="{Binding KindLabel}" Width="70"/>
                                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="تفاصيل" Binding="{Binding Detail}" Width="120"/>
                                        <DataGridTemplateColumn Header="" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="حذف" Style="{StaticResource GhostButton}"
                                                            Click="DeleteRow_Click" Tag="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="EmptyHint" Style="{StaticResource DataPanel}" VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                        <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center"/>
                        <TextBlock Text="اختر مجموعة أو أنشئ واحدة" Style="{StaticResource H2}"
                                   HorizontalAlignment="Center" Margin="0,12,0,6"/>
                        <TextBlock Text="أضف منتجات متتالية دون مغادرة المجموعة"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        <Button Content="+ إنشاء مجموعة" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center" Margin="0,16,0,0" Click="NewGroup_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
