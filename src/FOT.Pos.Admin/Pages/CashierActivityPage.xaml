<UserControl x:Class="FOT.Pos.Admin.Pages.CashierActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Style="{StaticResource FilterBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="من" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="FromDate"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="إلى" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="ToDate"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Width="240" KeyDown="SearchBox_OnKeyDown"/>
                    <Button Content="استعراض" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Search_Click"/>
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource StatusPill}" VerticalAlignment="Bottom">
                    <TextBlock Text="سجل أحداث الكاشير" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <Border Style="{StaticResource DataPanel}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="أحداث الكاشير" Style="{StaticResource H2}"/>
                        <TextBlock Grid.Column="1" Text="تسجيل الدخول والبيع والإغلاق" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <DataGrid x:Name="Grid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكاشير" Binding="{Binding CashierName}" Width="90"/>
                        <DataGridTextColumn Header="الحدث" Binding="{Binding EventLabel}" Width="140"/>
                        <DataGridTextColumn Header="نقطة المبيعات" Binding="{Binding PosPath}" Width="*"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150"/>
                        <DataGridTextColumn Header="رقم الإيصال" Binding="{Binding ReceiptNum}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
