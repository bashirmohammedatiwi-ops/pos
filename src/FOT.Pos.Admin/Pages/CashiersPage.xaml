<UserControl x:Class="FOT.Pos.Admin.Pages.CashiersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True">
    <Border Style="{StaticResource DashboardDataPanel}">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="300" MinWidth="200" Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="38,10,12,10" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource PageMdl2Icon}" Foreground="#64748B" IsHitTestVisible="False"
                                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                        </Grid>
                        <Button Content="بحث" Style="{StaticResource TopBarActionButton}" Padding="14,9" Click="Search_Click"/>
                        <Button Content="مسح" Style="{StaticResource TopBarActionButton}" Padding="14,9" Margin="8,0,0,0" Click="ClearSearch_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="&#xE710; إضافة كاشير" Style="{StaticResource TopBarPrimaryAction}" Padding="16,9" Click="Add_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="16,14,16,0">
                <Border Style="{StaticResource DashboardKpiCard}" Margin="0,0,10,14">
                    <StackPanel>
                        <TextBlock Text="إجمالي الكاشير" Style="{StaticResource DashboardCaption}"/>
                        <TextBlock x:Name="KpiTotal" Style="{StaticResource DashboardStatValue}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiCard}" Margin="0,0,10,14">
                    <StackPanel>
                        <TextBlock Text="نشط" Style="{StaticResource DashboardCaption}"/>
                        <TextBlock x:Name="KpiActive" Style="{StaticResource DashboardStatValue}" Foreground="#047857" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="غير نشط" Style="{StaticResource DashboardCaption}"/>
                        <TextBlock x:Name="KpiInactive" Style="{StaticResource DashboardStatValue}" Foreground="#BE123C" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource PremiumDataFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RangeLabel" Style="{StaticResource DashboardCaption}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevBtn" Style="{StaticResource TopBarActionButton}" Padding="12,8" Click="Prev_Click">
                            <TextBlock Text="السابق"/>
                        </Button>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,6" Margin="10,0">
                            <TextBlock x:Name="PageLabel" FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="NextBtn" Style="{StaticResource TopBarActionButton}" Padding="12,8" Click="Next_Click">
                            <TextBlock Text="التالي"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="انقر مرتين لتعديل الحساب والصلاحيات" Style="{StaticResource DashboardCaption}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
            </Border>

            <Grid Margin="16,0,16,16">
                <DataGrid x:Name="Grid" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="55"/>
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                        <DataGridTextColumn Header="قسم نقطة البيع" Binding="{Binding SectionName}" Width="*"/>
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding Active}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="EmptyPanel" Background="White" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="لا يوجد كاشير" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <Button Content="إضافة كاشير" Style="{StaticResource TopBarPrimaryAction}" Margin="0,12,0,0" Padding="16,9" Click="Add_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
