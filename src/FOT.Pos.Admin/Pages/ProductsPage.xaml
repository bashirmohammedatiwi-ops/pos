<UserControl x:Class="FOT.Pos.Admin.Pages.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Border Style="{StaticResource DashboardDataPanel}">
        <DockPanel LastChildFill="True">

            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                            <Grid Width="360" MinWidth="220" MaxWidth="480" Margin="0,0,10,0">
                                <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Padding="38,10,12,10"
                                         KeyDown="SearchBox_KeyDown"/>
                                <TextBlock Text="&#xE721;" Style="{StaticResource PageMdl2Icon}"
                                           Foreground="#64748B" IsHitTestVisible="False"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                <TextBlock Text="ابحث بالاسم أو الرمز أو الباركود…" IsHitTestVisible="False"
                                           Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="14,0,36,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Content="بحث" Style="{StaticResource TopBarPrimaryAction}" Padding="18,10" Click="Search_Click"/>
                            <Button Content="مسح" Style="{StaticResource TopBarActionButton}" Padding="14,10" Margin="8,0,0,0"
                                    Click="ClearSearch_Click"/>
                        </StackPanel>

                        <!-- Stats chips -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,7" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE719;" Style="{StaticResource PageMdl2Icon}" Foreground="#047857" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TotalBadge" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource PageMdl2Icon}" Foreground="#1D4ED8" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="PageBadge" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="انقر مرتين على أي منتج لتعديل السعر والمخزون"
                               Style="{StaticResource DashboardCaption}" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Footer / pagination -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource PremiumDataFooter}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RangeLabel" Grid.Column="0" Style="{StaticResource DashboardCaption}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevBtn" Style="{StaticResource TopBarActionButton}" Padding="12,8" Click="Prev_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Text="السابق"/>
                            </StackPanel>
                        </Button>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="14,6" Margin="10,0">
                            <TextBlock x:Name="PageLabel" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                        </Border>
                        <Button x:Name="NextBtn" Style="{StaticResource TopBarActionButton}" Padding="12,8" Click="Next_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="التالي"/>
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                            CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="مزامنة Edari" FontSize="11" FontWeight="Medium" Foreground="#1D4ED8"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Table / empty -->
            <Grid Margin="0">
                <DataGrid x:Name="Grid" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick"
                          VerticalAlignment="Stretch" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding Num}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="السعر" Binding="{Binding Price, StringFormat=N0}" Width="95">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="خصم %" Binding="{Binding DiscountPercent, StringFormat=N0}" Width="75">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="المخزون" Binding="{Binding Stock, StringFormat=N0}" Width="85">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#047857"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="العرض" Binding="{Binding OfferName}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#64748B"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border x:Name="EmptyPanel" Background="White" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                        <Border Style="{StaticResource KpiIconBoxGreen}" Width="56" Height="56" Margin="0,0,0,16" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" Style="{StaticResource PageMdl2Icon}" Foreground="#047857" FontSize="20"/>
                        </Border>
                        <TextBlock Text="لا توجد منتجات" FontSize="17" FontWeight="SemiBold" Foreground="#0F172A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="جرّب كلمات بحث مختلفة أو امسح الفلتر لعرض كل المنتجات"
                                   Style="{StaticResource DashboardCaption}" TextAlignment="Center"
                                   HorizontalAlignment="Center" Margin="0,8,0,16"/>
                        <Button Content="مسح البحث" Style="{StaticResource TopBarActionButton}" Padding="16,9"
                                HorizontalAlignment="Center" Click="ClearSearch_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
