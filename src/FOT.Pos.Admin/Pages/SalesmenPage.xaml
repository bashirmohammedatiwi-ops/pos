<UserControl x:Class="FOT.Pos.Admin.Pages.SalesmenPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Style="{StaticResource FilterBar}">
            <TextBlock Text="قائمة البائعين — مزامنة من Edari" Style="{StaticResource Caption}"/>
        </Border>
        <Border Style="{StaticResource DataPanel}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="المندوبون النشطون" Style="{StaticResource H2}"/>
                        <TextBlock Grid.Column="1" Text="للاختيار في شاشة البيع" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <DataGrid x:Name="Grid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
