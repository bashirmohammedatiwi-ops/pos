<UserControl x:Class="FOT.Pos.Admin.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Style="{StaticResource FilterBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="الفترة" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker x:Name="FromDate"/>
                    <TextBlock Text="→" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0"/>
                    <DatePicker x:Name="ToDate" Margin="0,0,12,0"/>
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Width="180"/>
                    <Button Content="عرض التقرير" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Load_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="اختر الفترة ثم اضغط عرض التقرير" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource DataPanel}" Padding="0">
            <TabControl>
                <TabItem Header="حركة مواد">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="حركة المواد" Style="{StaticResource H2}"/>
                                <TextBlock Grid.Column="1" Text="المواد المباعة خلال الفترة" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="MovementGrid" IsReadOnly="True"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="مبيعات يومية">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="المبيعات اليومية" Style="{StaticResource H2}"/>
                                <TextBlock Grid.Column="1" Text="إجمالي المبيعات لكل يوم" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="DailyGrid" IsReadOnly="True"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="حسب المندوب">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="مبيعات المندوبين" Style="{StaticResource H2}"/>
                                <TextBlock Grid.Column="1" Text="مجمّعة حسب المندوب" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="SalesmanGrid" IsReadOnly="True"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="تقرير الصندوق">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="تقرير الصندوق" Style="{StaticResource H2}"/>
                                <TextBlock Grid.Column="1" Text="ملخص الصندوق للفترة المحددة" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                            <StackPanel>
                                <UniformGrid Columns="5" Margin="0,0,0,16">
                                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="إجمالي المبيعات" Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="CashTotalSales" Style="{StaticResource StatValue}" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="عدد الفواتير" Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="CashReceiptCount" Style="{StaticResource StatValue}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="المدفوع" Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="CashTotalPayment" Style="{StaticResource StatValue}" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="الباقي" Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="CashTotalChange" Style="{StaticResource StatValue}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource StatCard}">
                                        <StackPanel>
                                            <TextBlock Text="متوسط الفاتورة" Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="CashAverage" Style="{StaticResource StatValue}" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <Border Style="{StaticResource InfoBox}">
                                    <TextBlock x:Name="CashHint" Style="{StaticResource Caption}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</UserControl>
