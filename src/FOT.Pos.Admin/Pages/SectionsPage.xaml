<UserControl x:Class="FOT.Pos.Admin.Pages.SectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch">
    <Border Style="{StaticResource DashboardDataPanel}">
        <DockPanel LastChildFill="True">
            <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="نقاط البيع (الأقسام)" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="مزامنة Edari" Style="{StaticResource TopBarActionButton}" Padding="14,9" Margin="0,0,8,0" Click="SyncEdari_Click"/>
                        <Button x:Name="DeleteBtn" Content="حذف" Style="{StaticResource TopBarActionButton}" Padding="14,9" Margin="0,0,8,0"
                                Click="Delete_Click" IsEnabled="False"/>
                        <Button Content="&#xE710; إضافة نقطة بيع" Style="{StaticResource TopBarPrimaryAction}" Padding="16,9" Click="Add_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="16,14,16,0">
                <Border Style="{StaticResource DashboardKpiCard}" Margin="0,0,10,14">
                    <StackPanel>
                        <TextBlock Text="إجمالي نقاط البيع" Style="{StaticResource DashboardCaption}"/>
                        <TextBlock x:Name="KpiTotal" Style="{StaticResource DashboardStatValue}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiCard}" Margin="0,0,10,14">
                    <StackPanel>
                        <TextBlock Text="نشط" Style="{StaticResource DashboardCaption}"/>
                        <TextBlock x:Name="KpiActive" Style="{StaticResource DashboardStatValue}" Foreground="#047857" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource DashboardKpiCard}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="صناديق مرتبطة" Style="{StaticResource DashboardCaption}"/>
                        <TextBlock x:Name="KpiCashBoxes" Style="{StaticResource DashboardStatValue}" Foreground="#1D4ED8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid Margin="16,0,16,16">
                <DataGrid x:Name="Grid" IsReadOnly="True" MouseDoubleClick="Grid_MouseDoubleClick"
                          SelectionChanged="Grid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="اسم نقطة البيع" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" Width="120"/>
                        <DataGridTextColumn Header="صناديق" Binding="{Binding CashBoxCount}" Width="70"/>
                        <DataGridTextColumn Header="أجهزة" Binding="{Binding TerminalCount}" Width="70"/>
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding State}" Width="60"/>
                        <DataGridTextColumn Header="مبيعات اليوم" Binding="{Binding TodaySales, StringFormat=N0}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
