<UserControl x:Class="FOT.Pos.Admin.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Style="{StaticResource FilterBar}">
            <TextBlock Text="عملاء البيع بالآجل — للاختيار في شاشة نقطة البيع" Style="{StaticResource Caption}"/>
        </Border>
        <Border Style="{StaticResource DataPanel}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="قائمة حسابات العملاء" Style="{StaticResource H2}"/>
                        <TextBlock Grid.Column="1" Text="مزامنة من Edari" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <DataGrid x:Name="Grid" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding Num}" Width="90"/>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="الرصيد (د.ع)" Binding="{Binding Balance, StringFormat=N0}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
