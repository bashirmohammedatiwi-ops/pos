<UserControl x:Class="FOT.Pos.Admin.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <DockPanel LastChildFill="True">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel MaxWidth="1280">

                <!-- Welcome -->
                <Border Style="{StaticResource DashboardWelcomeBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource KpiIconBoxBlue}" Width="44" Height="44" Margin="0,0,14,0">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource PageMdl2Icon}" Foreground="#1D4ED8" FontSize="16"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="WelcomeText" Text="مرحباً" FontSize="18" FontWeight="Bold" Foreground="#0F172A"
                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock Text="ملخص سريع لحالة المتجر والنظام" Style="{StaticResource DashboardCaption}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock x:Name="TodayDate" Foreground="#64748B" FontSize="12" FontWeight="Medium" HorizontalAlignment="Left"
                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                            <TextBlock x:Name="TodayTime" Foreground="#0F172A" FontSize="16" FontWeight="Bold"
                                       Margin="0,3,0,0" HorizontalAlignment="Left"
                                       TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- KPIs -->
                <UniformGrid Columns="5" Margin="0,0,0,16">
                    <Border Style="{StaticResource DashboardKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconBoxBlue}">
                                <TextBlock Text="&#xE7C8;" Style="{StaticResource PageMdl2Icon}" Foreground="#1D4ED8" FontSize="15"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="عروض نشطة" Style="{StaticResource DashboardCaption}"/>
                                <TextBlock x:Name="ActiveOffers" Style="{StaticResource DashboardStatValue}" Foreground="#1D4ED8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource DashboardKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconBoxGreen}">
                                <TextBlock Text="&#xE719;" Style="{StaticResource PageMdl2Icon}" Foreground="#047857" FontSize="15"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="المنتجات" Style="{StaticResource DashboardCaption}"/>
                                <TextBlock x:Name="EdariMaterials" Style="{StaticResource DashboardStatValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource DashboardKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconBoxAmber}">
                                <TextBlock Text="&#xE8A5;" Style="{StaticResource PageMdl2Icon}" Foreground="#B45309" FontSize="15"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="الشجرات" Style="{StaticResource DashboardCaption}"/>
                                <TextBlock x:Name="EdariTreeFolders" Style="{StaticResource DashboardStatValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource DashboardKpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconBoxViolet}">
                                <TextBlock Text="&#xE716;" Style="{StaticResource PageMdl2Icon}" Foreground="#6D28D9" FontSize="15"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="البائعون" Style="{StaticResource DashboardCaption}"/>
                                <TextBlock x:Name="EdariSalesmen" Style="{StaticResource DashboardStatValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource DashboardKpiCard}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconBoxRose}">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource PageMdl2Icon}" Foreground="#BE123C" FontSize="15"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="الأقسام" Style="{StaticResource DashboardCaption}"/>
                                <TextBlock x:Name="EdariBranches" Style="{StaticResource DashboardStatValue}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Quick access -->
                    <Border Grid.Column="0" Style="{StaticResource DashboardDataPanel}" Margin="0,0,12,0">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource PremiumPanelHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource KpiIconBoxBlue}" Width="36" Height="36" Margin="0,0,10,0">
                                        <TextBlock Text="&#xE71B;" Style="{StaticResource PageMdl2Icon}" Foreground="#1D4ED8" FontSize="13"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="وصول سريع" Style="{StaticResource H2}"/>
                                        <TextBlock Text="انتقل إلى أهم الأقسام" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="3" Margin="14,12,14,14">
                                <Button Style="{StaticResource DashboardNavTile}" Tag="products" Click="QuickNav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource KpiIconBoxGreen}" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE719;" Style="{StaticResource PageMdl2Icon}" Foreground="#047857" FontSize="13"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="المنتجات" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="مخزون وأسعار" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardNavTile}" Tag="receipts" Click="QuickNav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource KpiIconBoxBlue}" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE8A1;" Style="{StaticResource PageMdl2Icon}" Foreground="#1D4ED8" FontSize="13"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="الفواتير" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="استعراض وبحث" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardNavTile}" Tag="offers" Click="QuickNav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource KpiIconBoxAmber}" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE7C8;" Style="{StaticResource PageMdl2Icon}" Foreground="#B45309" FontSize="13"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="العروض" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="خصومات" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardNavTile}" Tag="reports" Click="QuickNav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource KpiIconBoxViolet}" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE9F9;" Style="{StaticResource PageMdl2Icon}" Foreground="#6D28D9" FontSize="13"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="التقارير" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="مبيعات" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardNavTile}" Tag="edari" Click="QuickNav_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource KpiIconBoxCyan}" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE895;" Style="{StaticResource PageMdl2Icon}" Foreground="#0E7490" FontSize="13"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Edari" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="مزامنة" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardNavTile}" Tag="settings" Click="QuickNav_Click" Margin="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource KpiIconBoxSlate}" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE713;" Style="{StaticResource PageMdl2Icon}" Foreground="#475569" FontSize="13"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="الطباعة" FontWeight="SemiBold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="إعدادات" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </DockPanel>
                    </Border>

                    <!-- Side panels -->
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource DashboardDataPanel}" Margin="0,0,0,12">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource PremiumPanelHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource KpiIconBoxCyan}" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE895;" Style="{StaticResource PageMdl2Icon}" Foreground="#0E7490" FontSize="13"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="حالة EdariNX" Style="{StaticResource H2}"/>
                                            <TextBlock Text="اتصال قاعدة الإداري" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PremiumSectionCard}" Margin="14" x:Name="EdariStatusBorder">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse x:Name="EdariDot" Width="9" Height="9" Fill="#94A3B8" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="EdariStatusTitle" Text="جاري التحقق…" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       FontSize="14" Foreground="#0F172A"/>
                                        </StackPanel>
                                        <TextBlock x:Name="EdariStatus" TextWrapping="Wrap" Style="{StaticResource DashboardBody}"/>
                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource DashboardDataPanel}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Style="{StaticResource PremiumPanelHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Style="{StaticResource KpiIconBoxSlate}" Width="36" Height="36" Margin="0,0,10,0">
                                            <TextBlock Text="&#xE946;" Style="{StaticResource PageMdl2Icon}" Foreground="#475569" FontSize="13"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="معلومات النظام" Style="{StaticResource H2}"/>
                                            <TextBlock Text="إصدار وآخر تحديث" Style="{StaticResource DashboardCaption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="14">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="الإصدار" Style="{StaticResource DashboardCaption}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="FOT POS v2" FontWeight="SemiBold" Foreground="#0F172A"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="آخر تحديث" Style="{StaticResource DashboardCaption}" Margin="0,10,0,0"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LastRefresh" Text="—" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,10,0,0"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
