<Window x:Class="FOT.Pos.Admin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FOT POS — تسجيل الدخول"
        Height="580" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FlowDirection="RightToLeft">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.55"/>
                    <GradientStop Color="#2563EB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                <Border CornerRadius="14" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,24"
                        Background="#FFFFFF20" BorderBrush="#FFFFFF30" BorderThickness="1">
                    <TextBlock Text="FOT" Foreground="White" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="FOT POS" Foreground="White" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="نظام إدارة نقاط البيع المتكامل" Foreground="#BFDBFE" FontSize="15"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <StackPanel Margin="0,28,0,0">
                    <TextBlock Text="• إدارة المنتجات والمخزون" Foreground="#93C5FD" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="• الفواتير والتقارير" Foreground="#93C5FD" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="• العروض والمزامنة مع Edari" Foreground="#93C5FD" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Column="1" Background="White" Effect="{StaticResource ShadowLg}">
            <StackPanel VerticalAlignment="Center" Margin="44,0">
                <TextBlock Text="تسجيل الدخول" FontSize="24" FontWeight="Bold"/>
                <TextBlock x:Name="SubtitleText" Text="أدخل بيانات الدخول للمتابعة" Style="{StaticResource Caption}" Margin="0,8,0,28"/>

                <StackPanel x:Name="RemotePanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <TextBlock Text="عنوان الخادم الرئيسي" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ServerUrlBox" ToolTip="مثال: 192.168.75.1 أو http://192.168.75.1:5000"/>
                    <TextBlock Text="يمكنك كتابة رقم IP فقط — المنفذ 5000 يُضاف تلقائياً"
                               Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="اختبار الاتصال" Style="{StaticResource SecondaryButton}" Click="TestConnection_Click"/>
                        <TextBlock x:Name="ConnectionStatus" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="LanHintBorder" Visibility="Collapsed" Style="{StaticResource AlertSuccess}" Margin="0,0,0,16">
                    <TextBlock x:Name="LanHintText" TextWrapping="Wrap" FontSize="12" Foreground="#047857"/>
                </Border>

                <TextBlock Text="اسم المستخدم" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="UsernameBox" Text="admin"/>

                <TextBlock Text="كلمة المرور" Style="{StaticResource FieldLabel}" Margin="0,16,0,0"/>
                <PasswordBox x:Name="PasswordBox"/>

                <Border x:Name="ErrorBorder" Style="{StaticResource AlertError}" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <Button x:Name="LoginBtn" Content="دخول إلى النظام" Style="{StaticResource PrimaryButton}"
                        Margin="0,24,0,0" Click="Login_Click" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
