<UserControl x:Class="FOT.Pos.Admin.Controls.SidebarNav"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             FlowDirection="RightToLeft"

             HorizontalAlignment="Stretch"

             VerticalAlignment="Stretch">

    <Border Background="{StaticResource SidebarBackgroundBrush}" ClipToBounds="True">

        <DockPanel LastChildFill="True">

            <Border DockPanel.Dock="Top" Padding="18,20,18,16" BorderBrush="#1E293B" BorderThickness="0,0,0,1">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>



                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,12,0">

                        <Border.Background>

                            <StaticResource ResourceKey="SidebarBrandGradientBrush"/>

                        </Border.Background>

                        <TextBlock Text="F" Foreground="White" FontSize="18" FontWeight="Bold"

                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    </Border>



                    <StackPanel Grid.Column="1" VerticalAlignment="Center">

                        <TextBlock Text="FOT POS" Style="{StaticResource SidebarBrandTitle}"/>

                        <TextBlock Text="لوحة الإدارة" Style="{StaticResource SidebarBrandSubtitle}"/>

                    </StackPanel>

                </Grid>

            </Border>



            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"

                          Padding="0,6,0,12">

                <StackPanel x:Name="RootPanel" Margin="10,0,10,0"/>

            </ScrollViewer>

        </DockPanel>

    </Border>

</UserControl>

