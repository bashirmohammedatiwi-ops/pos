<Window x:Class="FOT.Pos.Admin.OfferPercentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نسبة الخصم"
        Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        ResizeMode="NoResize">
    <Border Style="{StaticResource DialogShell}" Margin="20">
        <DockPanel>
            <TextBlock x:Name="TitleLabel" DockPanel.Dock="Top" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="تطبيق" Style="{StaticResource PrimaryButton}" Click="Ok_Click" IsDefault="True"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Border>
            <StackPanel>
                <TextBlock Text="نسبة التخفيض %" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PercentBox" Style="{StaticResource InputBox}" Text="10" FontSize="16"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
