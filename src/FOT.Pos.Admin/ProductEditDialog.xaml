<Window x:Class="FOT.Pos.Admin.ProductEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تعديل منتج" Height="520" Width="440"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}" ResizeMode="NoResize">
    <Border Style="{StaticResource DialogShell}" Margin="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="تعديل المنتج" Style="{StaticResource H2}"/>
                <TextBlock Text="تحديث الاسم والسعر والمخزون" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="البيانات الأساسية" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="الاسم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>
                    <TextBlock Text="الباركود" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="BarcodeBox" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>
                    <TextBlock Text="التسعير" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="السعر الأصلي" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="OriginalPriceBox" Style="{StaticResource InputBox}" Margin="0,0,0,12"/>
                    <TextBlock Text="السعر النهائي" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="FinalPriceBox" Style="{StaticResource InputBox}" Margin="0,0,0,16"/>
                    <TextBlock Text="المخزون" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="StockBox" Style="{StaticResource InputBox}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
