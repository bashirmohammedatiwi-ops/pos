<Window x:Class="FOT.Pos.Admin.SectionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="قسم" Height="680" Width="560"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}" ResizeMode="NoResize">
    <Border Style="{StaticResource DialogShell}" Margin="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock x:Name="TitleLabel" Text="قسم" Style="{StaticResource H2}"/>
                <TextBlock x:Name="SubtitleLabel" Style="{StaticResource DashboardCaption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Cancel_Click"/>
                    </StackPanel>
                    <Button x:Name="DeleteBtn" Content="حذف القسم" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Foreground="{StaticResource DangerBrush}"
                            Visibility="Collapsed" Click="Delete_Click"/>
                </Grid>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="اسم القسم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ActiveBox" Content="قسم نشط" FontWeight="SemiBold" Margin="0,0,0,16"/>

                    <TextBlock Text="حسابات القسم *" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="حساب الترحيل في Edari — صناديق المحل، دلفري بغداد، دلفري خط ناقل، وغيرها. الفاتورة بعد الدمج تظهر في الحساب المختار."
                               TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource PremiumSectionCard}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AccountSearchBox" Grid.Column="0" Style="{StaticResource InputBox}" Margin="0,0,8,0"
                                         TextChanged="AccountSearchBox_OnTextChanged"/>
                                <Button Grid.Column="1" Content="بحث" Click="SearchAccounts_Click" Style="{StaticResource SecondaryButton}"/>
                            </Grid>
                            <ListBox x:Name="AccountList" MaxHeight="120" Margin="0,0,0,8"
                                     DisplayMemberPath="Label" MouseDoubleClick="AccountList_OnDoubleClick"/>
                            <Button Content="+ إضافة الحساب المحدد" Style="{StaticResource SecondaryButton}" Margin="0,0,0,10"
                                    Click="AddAccount_Click"/>
                            <ListView x:Name="AssignedList" MaxHeight="160">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="الحساب" Width="280" DisplayMemberBinding="{Binding Label}"/>
                                        <GridViewColumn Header="افتراضي" Width="70">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="DefaultCashBox" IsChecked="{Binding IsDefault, Mode=TwoWay}"
                                                                 HorizontalAlignment="Center" Checked="DefaultBox_Changed"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="" Width="60">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="حذف" Style="{StaticResource SecondaryButton}" Padding="8,4"
                                                            Click="RemoveBox_Click" Tag="{Binding}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </StackPanel>
                    </Border>

                    <Expander Header="إعدادات Edari (اختياري)" IsExpanded="False">
                        <Border Style="{StaticResource PremiumSectionCard}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="رمز Edari" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SymbolBox" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
                                <TextBlock Text="سعر البيع (فهرس)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="SellPriceBox" Style="{StaticResource InputBox}" Margin="0,0,0,10"/>
                                <TextBlock Text="ربط Edari" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Margin="0,0,0,10">
                                    <RadioButton x:Name="NewEdariBranchRadio" Content="إنشاء فرع جديد" IsChecked="True"
                                                 Margin="0,0,0,6" Checked="EdariMode_Changed"/>
                                    <RadioButton x:Name="LinkEdariBranchRadio" Content="ربط بفرع موجود"
                                                 Checked="EdariMode_Changed"/>
                                </StackPanel>
                                <TextBlock x:Name="EdariBranchLabel" Text="فرع Edari" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="EdariBranchCombo" DisplayMemberPath="Name" Margin="0,0,0,10"/>
                                <TextBlock Text="رقم المخزن" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="WarehouseBox" Style="{StaticResource InputBox}"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
