<Window x:Class="FOT.Pos.Admin.TargetCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="هدف مبيعات" Height="520" Width="440" WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" Background="{StaticResource BgBrush}" ResizeMode="NoResize">
    <Border Style="{StaticResource DialogShell}" Margin="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="هدف مبيعات" Style="{StaticResource H2}"/>
                <TextBlock Text="تعريف هدف جديد وتتبع التقدم" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                    <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="الاسم" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>
                    <TextBlock Text="نوع الهدف" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="TypeCombo" Margin="0,0,0,14">
                        <ComboBoxItem Content="مبلغ مبيعات" Tag="amount" IsSelected="True"/>
                        <ComboBoxItem Content="كمية مبيعات" Tag="quantity"/>
                    </ComboBox>
                    <TextBlock Text="القيمة المطلوبة" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ValueBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>
                    <TextBlock Text="شجرة الإداري (اختياري)" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBox x:Name="TreeBox" Style="{StaticResource InputBox}" IsReadOnly="True" Width="280"/>
                        <Button Content="اختيار" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="8,0,0,0" Click="PickTree_Click"/>
                    </StackPanel>
                    <TextBlock Text="الفترة" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PeriodCombo">
                        <ComboBoxItem Content="شهري" Tag="monthly" IsSelected="True"/>
                        <ComboBoxItem Content="أسبوعي" Tag="weekly"/>
                        <ComboBoxItem Content="يومي" Tag="daily"/>
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
