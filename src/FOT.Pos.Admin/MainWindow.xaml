<Window x:Class="FOT.Pos.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:FOT.Pos.Admin.Controls"
        Title="FOT POS"
        Height="920" Width="1480"
        MinHeight="700" MinWidth="1140"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FlowDirection="RightToLeft">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" MinWidth="288"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ctrl:SidebarNav x:Name="Sidebar" Grid.Column="0"/>

        <DockPanel Grid.Column="1">
            <!-- Top bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource TopAppBar}">
                <Grid Margin="20,0" MinHeight="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="BreadcrumbLabel" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock x:Name="PageTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,2,0,0"/>
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0" MaxWidth="560"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource TopBarUserChip}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="8" Width="30" Height="30" Margin="0,0,8,0" Background="{StaticResource PrimaryBrush}">
                                    <TextBlock x:Name="UserInitial" Text="A" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="UserLabel" Foreground="{StaticResource TextBrush}" FontSize="13"
                                           VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TopBarUserChip}" Margin="0,0,8,0" ToolTip="حالة الاتصال بالسيرفر">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ApiDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ApiStatus" Text="API" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="تحديث" Style="{StaticResource TopBarActionButton}" Click="Refresh_Click"/>
                        <Button Content="خروج" Style="{StaticResource TopBarActionButton}" Margin="6,0,0,0" Click="Logout_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource BgBrush}" Padding="20">
                <ContentControl x:Name="PageHost"
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"/>
            </Border>
        </DockPanel>
    </Grid>
</Window>
