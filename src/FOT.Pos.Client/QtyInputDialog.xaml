<Window x:Class="FOT.Pos.Client.QtyInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:FOT.Pos.Client.Services"
        Title="تعديل الكمية" Height="360" Width="460"
        services:TouchKeyboardHelper.Suppress="True">
    <Grid>
        <Border Style="{StaticResource OverlayScrim}"/>
        <Border Style="{StaticResource OverlayCard}" Width="420">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource OverlayHeader}">
                    <Grid>
                        <TextBlock Text="تعديل الكمية" Style="{StaticResource PosDialogTitle}" FontSize="18" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Left" Click="Cancel_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OverlayBody}">
                    <StackPanel>
                        <TextBlock x:Name="ProductLabel" Text="الكمية" Style="{StaticResource PosDialogTitle}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="16"/>
                        <TextBlock Text="أدخل الكمية الجديدة" Style="{StaticResource PosDialogSubtitle}" HorizontalAlignment="Center" Margin="0,4,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="−" Style="{StaticResource TouchQtyChipButton}" Click="Minus_Click"/>
                            <TextBox x:Name="QtyBox" Grid.Column="1" Style="{StaticResource InputBox}" FontSize="32" FontWeight="Bold"
                                     Margin="10,0" HorizontalContentAlignment="Center" MinHeight="56"
                                     KeyDown="QtyBox_OnKeyDown" services:TouchKeyboardHelper.Suppress="True"/>
                            <Button Grid.Column="2" Content="+" Style="{StaticResource QtyPlusButton}" Click="Plus_Click"/>
                        </Grid>
                        <TextBlock x:Name="ErrorLabel" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Content="تطبيق" Style="{StaticResource CompleteSaleButton}" FontSize="16" Padding="28,14" MinHeight="50" Click="Ok_Click" IsDefault="True"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,14" MinHeight="50" Click="Cancel_Click" IsCancel="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
