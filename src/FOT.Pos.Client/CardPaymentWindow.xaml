<Window x:Class="FOT.Pos.Client.CardPaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="640" Width="780"
        Loaded="Window_OnLoaded">
    <Grid>
        <Border x:Name="Backdrop" Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#CCF8FBFF" Offset="0"/>
                    <GradientStop Color="#D9F0FDF9" Offset="0.5"/>
                    <GradientStop Color="#CCEEF6FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border x:Name="MainCard" Opacity="0" Margin="28" CornerRadius="32"
                BorderBrush="#E8F0F7" BorderThickness="1"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5"
                Effect="{StaticResource ShadowLg}">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                    <TranslateTransform X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FDFFFE" Offset="0"/>
                    <GradientStop Color="#F3FBFF" Offset="0.45"/>
                    <GradientStop Color="#F4FDF8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                    <Ellipse x:Name="Orb1" Width="280" Height="280" Canvas.Left="-70" Canvas.Top="-80"
                             Opacity="0.45" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#A7F3D0" Offset="0"/>
                                <GradientStop Color="#00A7F3D0" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Orb2" Width="240" Height="240" Canvas.Left="500" Canvas.Top="36"
                             Opacity="0.38" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#BAE6FD" Offset="0"/>
                                <GradientStop Color="#00BAE6FD" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Orb3" Width="200" Height="200" Canvas.Left="70" Canvas.Top="380"
                             Opacity="0.32" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#DDD6FE" Offset="0"/>
                                <GradientStop Color="#00DDD6FE" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Orb4" Width="160" Height="160" Canvas.Left="490" Canvas.Top="360"
                             Opacity="0.28" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FED7AA" Offset="0"/>
                                <GradientStop Color="#00FED7AA" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="Spark1" Width="7" Height="7" Fill="#99A7F3D0" Canvas.Left="90" Canvas.Top="430">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Spark2" Width="5" Height="5" Fill="#99BAE6FD" Canvas.Left="180" Canvas.Top="460">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Spark3" Width="8" Height="8" Fill="#99C4B5FD" Canvas.Left="320" Canvas.Top="440">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Spark4" Width="4" Height="4" Fill="#99FDE68A" Canvas.Left="470" Canvas.Top="470">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Spark5" Width="6" Height="6" Fill="#99A7F3D0" Canvas.Left="560" Canvas.Top="420">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Spark6" Width="5" Height="5" Fill="#99BAE6FD" Canvas.Left="250" Canvas.Top="480">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Spark7" Width="6" Height="6" Fill="#99FBCFE8" Canvas.Left="400" Canvas.Top="450">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Spark8" Width="4" Height="4" Fill="#99A7F3D0" Canvas.Left="130" Canvas.Top="500">
                        <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>

                <Grid x:Name="WaitingScene" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource CardPayNfcPulse}"/>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Ellipse x:Name="FloorShadow" Width="260" Height="36" Fill="#220F172A"
                             VerticalAlignment="Bottom" Margin="0,0,0,-8" Opacity="0.28"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse x:Name="HaloOuter" Width="420" Height="420" Stroke="#66A7F3D0" StrokeThickness="1.5"
                             StrokeDashArray="3 10" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="HaloInner" Width="340" Height="340" Stroke="#55BAE6FD" StrokeThickness="2"
                             StrokeDashArray="1 14" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                    </Ellipse>

                    <Canvas Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="NfcRing1" Width="110" Height="110" Stroke="#8010B981" StrokeThickness="2.2"
                                 Canvas.Left="95" Canvas.Top="95" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.42" ScaleY="0.42"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="NfcRing2" Width="110" Height="110" Stroke="#8038BDF8" StrokeThickness="2.2"
                                 Canvas.Left="95" Canvas.Top="95" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.42" ScaleY="0.42"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="NfcRing3" Width="110" Height="110" Stroke="#80A78BFA" StrokeThickness="2"
                                 Canvas.Left="95" Canvas.Top="95" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.42" ScaleY="0.42"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="NfcRing4" Width="110" Height="110" Stroke="#80FBBF24" StrokeThickness="1.8"
                                 Canvas.Left="95" Canvas.Top="95" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.42" ScaleY="0.42"/></Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>

                    <Border x:Name="CreditCardVisual" Width="340" Height="204" CornerRadius="22"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="#B8FFFFFF" BorderThickness="1.5" ClipToBounds="True"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="-4"/>
                                <TranslateTransform Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F0FDFA" Offset="0.4"/>
                                <GradientStop Color="#ECFEFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#94A3B8" Opacity="0.28" BlurRadius="32" ShadowDepth="10" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Rectangle Width="90" Opacity="0.45" HorizontalAlignment="Left" Margin="-90,0,0,0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform><TranslateTransform X="-160"/></Rectangle.RenderTransform>
                                <Rectangle.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource CardPayShimmer}"/>
                                    </EventTrigger>
                                </Rectangle.Triggers>
                            </Rectangle>

                            <Border x:Name="CardChip" Width="50" Height="38" CornerRadius="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,30,0"
                                    BorderBrush="#66FCD34D" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FDE68A" Offset="0"/>
                                        <GradientStop Color="#F59E0B" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Canvas HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,34,0,0" Width="48" Height="40">
                                <Path Data="M4,22 Q16,4 28,22" Stroke="#10B981" StrokeThickness="2.6" Opacity="0.35" Fill="Transparent"/>
                                <Path Data="M10,22 Q20,10 30,22" Stroke="#10B981" StrokeThickness="2.6" Opacity="0.55" Fill="Transparent"/>
                                <Path Data="M16,22 Q24,14 32,22" Stroke="#059669" StrokeThickness="2.6" Opacity="0.85" Fill="Transparent"/>
                            </Canvas>

                            <Rectangle Height="9" Fill="#E2E8F0" VerticalAlignment="Bottom" Margin="30,0,30,62" RadiusX="4" RadiusY="4"/>
                            <Rectangle Height="7" Width="96" Fill="#F1F5F9" VerticalAlignment="Bottom" Margin="30,0,0,38"
                                       HorizontalAlignment="Right" RadiusX="4" RadiusY="4"/>

                            <Canvas HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,22">
                                <Ellipse Width="34" Height="34" Canvas.Left="0" Fill="#EB001B" Opacity="0.92"/>
                                <Ellipse Width="34" Height="34" Canvas.Left="20" Fill="#F79E1B" Opacity="0.92"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>

                <Button x:Name="CloseButton" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="18" Width="44" Height="44" Click="Close_Click" IsCancel="True"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="إغلاق">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Width="44" Height="44" CornerRadius="22"
                                    Background="#B3FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Path Data="M8,8 L20,20 M20,8 L8,20" Stroke="#94A3B8" StrokeThickness="2.2"
                                      StrokeStartLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Width="28" Height="28" Stretch="Uniform"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFFFFF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#CBD5E1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border x:Name="ErrorHost" VerticalAlignment="Bottom" Margin="40,0,40,36"
                        Background="#FFF7F7" BorderBrush="#FECACA" BorderThickness="1"
                        CornerRadius="18" Padding="22,16" Visibility="Collapsed"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><TranslateTransform Y="0"/></Border.RenderTransform>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ErrorText" FontSize="15" FontWeight="SemiBold" Foreground="#DC2626"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="RetryButton" Grid.Column="1" Width="48" Height="48" Margin="16,0,0,0"
                                Click="Retry_Click" Cursor="Hand" ToolTip="إعادة المحاولة">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="14" Background="#10B981">
                                        <Path Data="M12,4 A8,8 0 1 1 4,12" Stroke="White" StrokeThickness="2.4"
                                              StrokeStartLineCap="Round" Fill="Transparent"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="22" Height="22" Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#059669"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="SuccessPanel" Background="#E8FFFFFF" Visibility="Collapsed"
                        CornerRadius="32" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                    <Grid>
                        <Ellipse x:Name="SuccessBurst" Width="160" Height="160" Stroke="#6610B981" StrokeThickness="4"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="SuccessBurst2" Width="120" Height="120" Stroke="#5538BDF8" StrokeThickness="3"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform><ScaleTransform ScaleX="0.6" ScaleY="0.6"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Border Width="92" Height="92" CornerRadius="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#34D399" Offset="0"/>
                                    <GradientStop Color="#10B981" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" Opacity="0.35" BlurRadius="24" ShadowDepth="0"/>
                            </Border.Effect>
                            <Path Data="M26,48 L40,62 L68,32" Stroke="White" StrokeThickness="5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
