<Window x:Class="FOT.Pos.Client.OfferCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="عرض جديد" Height="380" Width="460">
    <Grid>
        <Border Style="{StaticResource OverlayScrim}"/>
        <Border Style="{StaticResource OverlayCard}" Width="420">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource OverlayHeader}">
                    <Grid>
                        <TextBlock Text="إنشاء عرض جديد" Style="{StaticResource PosDialogTitle}" FontSize="18" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Left" Click="Cancel_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OverlayBody}">
                    <StackPanel>
                        <TextBlock Text="اسم العرض" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>
                        <TextBlock Text="الأولوية (الأعلى يُطبَّق أولاً)" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <TextBox x:Name="PriorityBox" Style="{StaticResource InputBox}" Text="1" Margin="0,0,0,14"/>
                        <CheckBox x:Name="EnabledBox" Content="عرض نشط" IsChecked="True" Margin="0,0,0,18" FontSize="14"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="إنشاء" Style="{StaticResource CompleteSaleButton}" FontSize="15" Padding="28,13" Click="Save_Click" IsDefault="True"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,13" Click="Cancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
