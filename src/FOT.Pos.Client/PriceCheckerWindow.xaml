<Window x:Class="FOT.Pos.Client.PriceCheckerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:FOT.Pos.Client.Services"
        Title="فحص السعر" Height="520" Width="580"
        services:TouchKeyboardHelper.Suppress="True">
    <Grid>
        <Border Style="{StaticResource OverlayScrim}"/>
        <Border Style="{StaticResource OverlayCard}" Width="520">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource OverlayHeader}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#ECFDF5" Margin="0,0,12,0">
                                <ContentControl ContentTemplate="{StaticResource IconTag}" Foreground="#059669"
                                                Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="فحص السعر" Style="{StaticResource PosDialogTitle}" FontSize="18"/>
                                <TextBlock Text="امسح الباركود ثم Enter" Style="{StaticResource PosDialogSubtitle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Left" Click="Close_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OverlayBody}">
                    <StackPanel>
                        <Border Style="{StaticResource ScanBar}" Padding="8,6">
                            <TextBox x:Name="BarcodeBox" Style="{StaticResource ScanInputBox}" FontSize="22"
                                     services:TouchKeyboardHelper.Suppress="True" KeyDown="BarcodeBox_OnKeyDown"/>
                        </Border>
                        <Border x:Name="ResultCard" CornerRadius="18" Padding="28,26" Margin="0,18,0,0"
                                BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" MinHeight="180">
                            <StackPanel>
                                <TextBlock x:Name="ProductName" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           TextAlignment="Center" Text="بانتظار المسح"/>
                                <TextBlock x:Name="ProductPrice" FontSize="46" FontWeight="Bold"
                                           Foreground="{StaticResource TealBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock x:Name="OfferLabel" Foreground="#D97706" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
