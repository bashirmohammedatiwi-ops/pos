<Application x:Class="FOT.Pos.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose"
             Startup="App_OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Dialog shell — defined here so overlay windows work even if Theme.xaml is stale in a deployed build -->
            <Style x:Key="PosDialogWindow" TargetType="Window">
                <Setter Property="WindowStyle" Value="None"/>
                <Setter Property="AllowsTransparency" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ShowInTaskbar" Value="False"/>
                <Setter Property="ResizeMode" Value="NoResize"/>
                <Setter Property="WindowStartupLocation" Value="Manual"/>
                <Setter Property="FlowDirection" Value="RightToLeft"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml"/>
                <ResourceDictionary Source="Resources/PosIcons.xaml"/>
                <ResourceDictionary Source="Resources/DataTemplates.xaml"/>
                <ResourceDictionary Source="Resources/PosAnimations.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
