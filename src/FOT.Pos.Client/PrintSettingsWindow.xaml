<Window x:Class="FOT.Pos.Client.PrintSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات الطباعة"
        Width="560" Height="560">
    <Grid>
        <Border Style="{StaticResource OverlayScrim}"/>
        <Border Style="{StaticResource OverlayCard}" Width="520">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource OverlayHeader}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#ECFDF5" Margin="0,0,12,0">
                                <ContentControl ContentTemplate="{StaticResource IconPrint}" Foreground="#059669"
                                                Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الطابعة المحلية" Style="{StaticResource PosDialogTitle}" FontSize="18"/>
                                <TextBlock Text="شكل الفاتورة يُدار من لوحة الإدارة" Style="{StaticResource PosDialogSubtitle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Left" Click="Close_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OverlayBody}">
                    <StackPanel>
                        <TextBlock Text="الطابعة" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="PrinterCombo" MinHeight="48" Margin="0,0,0,14"/>

                        <CheckBox x:Name="AskBeforePrintChk" Content="السؤال قبل الطباعة" Margin="0,0,0,16" FontSize="14"/>

                        <Border Background="#F8FAFC" CornerRadius="14" Padding="16" Margin="0,0,0,16"
                                BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock x:Name="SettingsSummary" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource MutedBrush}"/>
                        </Border>

                        <TextBlock x:Name="StatusLabel" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,0,14" Visibility="Collapsed"/>

                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Button Content="طباعة تجريبية" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="14,12" Click="TestPrint_Click"/>
                            <Button Content="إعادة آخر فاتورة" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="14,12" Click="Reprint_Click"/>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="حفظ" Style="{StaticResource CompleteSaleButton}" FontSize="16" Padding="32,13" Click="Save_Click"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,13" Click="Close_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
