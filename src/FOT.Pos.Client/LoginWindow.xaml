<Window x:Class="FOT.Pos.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:FOT.Pos.Client.Services"
        Title="FOT POS — نقطة البيع"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{StaticResource BgBrush}"
        FlowDirection="RightToLeft"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        services:TouchKeyboardHelper.Suppress="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CashierHeader}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#34D399" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="FOT" Foreground="White" FontWeight="Bold" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="نقطة البيع" Style="{StaticResource HeaderTitleText}" FontSize="15"/>
                        <TextBlock Text="تسجيل دخول الكاشير" Style="{StaticResource HeaderSubText}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="ConnectionBadge" Style="{StaticResource DarkStatusChip}" Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectionBadgeText" Text="جاري الاتصال…" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ServerUrlLabel" Text="" Foreground="#94A3B8" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ClockLabel" FontSize="18" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource HeaderLogoutButton}" Click="Exit_Click" ToolTip="إغلاق">
                        <StackPanel>
                            <ContentControl ContentTemplate="{StaticResource IconExit}" Width="20" Height="20" HorizontalAlignment="Center" Foreground="#FECACA"/>
                            <TextBlock Text="خروج" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border Width="960" Height="540" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="24" ClipToBounds="True" BorderBrush="#E2E8F0" BorderThickness="1"
                    Effect="{StaticResource ShadowLg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource HeaderGradient}">
                        <StackPanel VerticalAlignment="Center" Margin="32">
                            <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Right" Margin="0,0,0,20">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#34D399" Offset="0"/>
                                        <GradientStop Color="#059669" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentControl ContentTemplate="{StaticResource IconCash}" Foreground="White"
                                                Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="FOT POS" FontSize="28" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Right"/>
                            <TextBlock Text="صندوق الكاشير" FontSize="15" Foreground="#94A3B8"
                                       HorizontalAlignment="Right" Margin="0,6,0,20"/>
                            <TextBlock Text="أدخل رمز الدخول لفتح الصندوق والبدء بالبيع. تأكد أن الخادم متصل قبل المتابعة."
                                       FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="22"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" Padding="40,36">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="فتح الصندوق" FontSize="24" FontWeight="Bold" Foreground="{StaticResource InkBrush}"/>
                            <TextBlock Text="أدخل الرمز ثم Enter" Foreground="{StaticResource MutedBrush}"
                                       FontSize="14" Margin="0,4,0,22"/>

                            <Border Style="{StaticResource ScanBar}" Padding="8,6" MinHeight="72">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="12" Background="#ECFDF5" Margin="2,0,10,0">
                                        <TextBlock Text="•••" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TealBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <PasswordBox x:Name="PinBox" Grid.Column="1" Style="{StaticResource ScanPinInputBox}"
                                                 KeyDown="PinBox_OnKeyDown" CaretBrush="{StaticResource TealBrush}"
                                                 services:TouchKeyboardHelper.Suppress="True"/>
                                </Grid>
                            </Border>

                            <Border x:Name="ErrorHost" Background="#FEF2F2" CornerRadius="12" Padding="14,10"
                                    Margin="0,14,0,0" BorderBrush="#FECACA" BorderThickness="1" Visibility="Collapsed">
                                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                                           FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>

                            <Button x:Name="LoginBtn" Content="دخول إلى الصندوق" Style="{StaticResource PayPrimaryButton}"
                                    Margin="0,22,0,0" Click="Login_Click" IsDefault="True"/>

                            <Expander x:Name="ServerSettings" Header="إعدادات الخادم" Margin="0,18,0,0"
                                      Foreground="{StaticResource MutedBrush}" FontSize="13" FontWeight="SemiBold">
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="عنوان الحاسبة الرئيسية" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                                    <TextBox x:Name="ServerUrlBox" Style="{StaticResource InputBox}" FontSize="14"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="اختبار الاتصال" Style="{StaticResource SecondaryButton}"
                                                Padding="16,12" Click="TestConnection_Click"/>
                                        <TextBlock x:Name="ConnectionStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
