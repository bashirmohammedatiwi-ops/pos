<Window x:Class="FOT.Pos.Client.OfferPercentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نسبة الخصم" Height="300" Width="440">
    <Grid>
        <Border Style="{StaticResource OverlayScrim}"/>
        <Border Style="{StaticResource OverlayCard}" Width="400">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource OverlayHeader}">
                    <Grid>
                        <TextBlock Text="نسبة الخصم" Style="{StaticResource PosDialogTitle}" FontSize="18" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Left" Click="Cancel_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OverlayBody}">
                    <StackPanel>
                        <TextBlock x:Name="TitleLabel" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <TextBlock Text="نسبة التخفيض %" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <TextBox x:Name="PercentBox" Style="{StaticResource InputBox}" Text="10" FontSize="28" FontWeight="Bold"
                                 HorizontalContentAlignment="Center" MinHeight="56" Margin="0,0,0,12"/>
                        <TextBlock x:Name="ErrorLabel" Foreground="#DC2626" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Visibility="Collapsed" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="تطبيق" Style="{StaticResource CompleteSaleButton}" FontSize="15" Padding="28,13" Click="Ok_Click" IsDefault="True"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,13" Click="Cancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
