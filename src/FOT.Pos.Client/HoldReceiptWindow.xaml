<Window x:Class="FOT.Pos.Client.HoldReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فواتير معلّقة" Height="560" Width="760">
    <Grid>
        <Border Style="{StaticResource OverlayScrim}"/>
        <Border Style="{StaticResource OverlayCard}" Width="700" MaxHeight="620">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource OverlayHeader}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#FFFBEB" Margin="0,0,12,0">
                                <ContentControl ContentTemplate="{StaticResource IconHold}" Foreground="#D97706"
                                                Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الفواتير المعلّقة" Style="{StaticResource PosDialogTitle}" FontSize="18"/>
                                <TextBlock Text="انقر مرتين لاسترجاع الفاتورة إلى السلة" Style="{StaticResource PosDialogSubtitle}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Left" Click="Cancel_Click"/>
                    </Grid>
                </Border>
                <Border DockPanel.Dock="Bottom" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Background="#F8FAFC">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="استرجاع إلى السلة" Style="{StaticResource CompleteSaleButton}" FontSize="15" Padding="28,13"
                                Click="Recall_Click" IsDefault="True"/>
                        <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,13" Click="Cancel_Click"/>
                    </StackPanel>
                </Border>
                <Border Padding="16">
                    <DataGrid x:Name="Grid" Style="{StaticResource PosCartGrid}" RowHeight="56" FontSize="14"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              MouseDoubleClick="Grid_OnMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding CreationDate, StringFormat=dd/MM HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat=N0}" Width="120"/>
                            <DataGridTextColumn Header="أصناف" Binding="{Binding ItemCount}" Width="80"/>
                            <DataGridTextColumn Header="المندوب" Binding="{Binding SalesmanName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
