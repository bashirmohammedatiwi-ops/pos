    <Geometry x:Key="IconCloseGeo">M6,6 L18,18 M18,6 L6,18</Geometry>

    <Style x:Key="PosIconPath" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <DataTemplate x:Key="IconScan">
        <Path Style="{StaticResource PosIconPath}" Data="{StaticResource IconScanGeo}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Control}, Path=Foreground}"/>
    </DataTemplate>
