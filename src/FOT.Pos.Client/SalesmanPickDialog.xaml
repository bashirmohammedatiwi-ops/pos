<Window x:Class="FOT.Pos.Client.SalesmanPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dto="clr-namespace:FOT.Pos.Shared.Dtos;assembly=FOT.Pos.Shared"
        xmlns:services="clr-namespace:FOT.Pos.Client.Services"
        Title="اختيار المندوب" Height="520" Width="480"
        services:TouchKeyboardHelper.Suppress="True">
    <Grid>
        <Border Style="{StaticResource OverlayScrim}"/>
        <Border Style="{StaticResource OverlayCard}" Width="440">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource OverlayHeader}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="اختيار المندوب" Style="{StaticResource PosDialogTitle}" FontSize="18"/>
                            <TextBlock x:Name="ReasonLabel" Style="{StaticResource PosDialogSubtitle}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Left" Click="Cancel_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OverlayBody}">
                    <StackPanel>
                        <TextBlock x:Name="ProductLabel" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="اكتب رقم المندوب ثم Enter — أو اختر من القائمة" FontSize="12"
                                   Foreground="#64748B" Margin="0,0,0,8" TextAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" FontSize="16" Padding="12,11"
                                 Margin="0,0,0,10" TextChanged="SearchBox_OnTextChanged"
                                 PreviewKeyDown="SearchBox_OnPreviewKeyDown"
                                 services:TouchKeyboardHelper.Suppress="True"/>
                        <ListBox x:Name="SalesmanList" MinHeight="240" MaxHeight="280" BorderBrush="#E2E8F0" BorderThickness="1"
                                 MouseDoubleClick="SalesmanList_OnMouseDoubleClick"
                                 SelectionChanged="SalesmanList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type dto:SalesmanDto}">
                                    <Border Padding="10,8" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Id}" FontSize="14" FontWeight="Bold"
                                                       Foreground="#0F766E" MinWidth="44"/>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Content="تأكيد" Style="{StaticResource CompleteSaleButton}" FontSize="15" Padding="28,12"
                                    MinHeight="46" Click="Ok_Click" IsDefault="True"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,12"
                                    MinHeight="46" Click="Cancel_Click" IsCancel="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
