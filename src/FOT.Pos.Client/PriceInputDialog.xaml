<Window x:Class="FOT.Pos.Client.PriceInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:FOT.Pos.Client.Services"
        Title="تعديل السعر" Height="360" Width="460"
        services:TouchKeyboardHelper.Suppress="True">
    <Grid>
        <Border Style="{StaticResource OverlayScrim}"/>
        <Border Style="{StaticResource OverlayCard}" Width="420">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource OverlayHeader}">
                    <Grid>
                        <TextBlock Text="تعديل السعر" Style="{StaticResource PosDialogTitle}" FontSize="18" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource OverlayCloseButton}" HorizontalAlignment="Left" Click="Cancel_Click"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource OverlayBody}">
                    <StackPanel>
                        <TextBlock x:Name="ProductLabel" Text="السعر" Style="{StaticResource PosDialogTitle}"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="16"/>
                        <TextBlock x:Name="OriginalLabel" Style="{StaticResource PosDialogSubtitle}" HorizontalAlignment="Center"/>
                        <TextBox x:Name="PriceBox" Style="{StaticResource InputBox}" FontSize="32" FontWeight="Bold"
                                 Margin="0,16,0,0" HorizontalContentAlignment="Center" MinHeight="56"
                                 KeyDown="PriceBox_OnKeyDown" services:TouchKeyboardHelper.Suppress="True"/>
                        <TextBlock x:Name="ErrorLabel" Foreground="#DC2626" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Content="تطبيق" Style="{StaticResource CompleteSaleButton}" FontSize="16" Padding="28,14" MinHeight="50" Click="Ok_Click" IsDefault="True"/>
                            <Button Content="إلغاء" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="24,14" MinHeight="50" Click="Cancel_Click" IsCancel="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
