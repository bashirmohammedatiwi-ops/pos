# Shop POS API (LAN machine). From Docker on the same PC use host.docker.internal.
FOT_SHOP_API_URL=http://host.docker.internal:5000

# Public host published on the VPS — do not use 80/443/3000/5000.
FOT_HTTP_PORT=4700
FOT_SELLER_PORT=4701
FOT_STAFF_PORT=4702
FOT_MANAGER_PORT=4703
PUBLIC_HOST=http://127.0.0.1:4700
