# Seller web reads the VPS hub. The shop POS pushes data to :4705.
FOT_SHOP_API_URL=http://hub:4705

# Private secrets — never commit real values. The hub refuses to start with these placeholders.
# Generate each with:  openssl rand -hex 32
# FOT_HUB_SYNC_KEY is shared with the shop server: up.sh generates it and prints it; paste it in the
# control panel (Team app -> Updates & notifications -> Hub link). It is stored on the shop server.
FOT_HUB_SYNC_KEY=CHANGE_ME
# Signs every seller/manager/team session. up.sh generates it when it is missing or still a default.
FOT_HUB_JWT_KEY=CHANGE_ME
# Session lifetime (hours) and how long an expired session can still be renewed (days).
FOT_HUB_JWT_HOURS=720
FOT_HUB_REFRESH_DAYS=30

# Public host published on the VPS — do not use 80/443/3000/5000.
FOT_HTTP_PORT=4700
FOT_SELLER_PORT=4701
FOT_STAFF_PORT=4702
FOT_MANAGER_PORT=4703
PUBLIC_HOST=http://127.0.0.1:4700
