{
  "appId": "com.fot.pos.cashier",
  "productName": "FOT POS Cashier",
  "copyright": "Copyright © Future of Technology",
  "directories": {
    "output": "dist-out84/cashier-ia32"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "roles/pos.txt",
      "to": "fot-role.txt"
    },
    {
      "from": "../web/fot-pos/dist",
      "to": "fot-pos"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "ia32"
        ]
      }
    ],
    "artifactName": "FOT-POS-Cashier-Setup-32bit.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "FOT POS كاشير",
    "include": "electron/installer-cashier.nsh",
    "deleteAppDataOnUninstall": false,
    "artifactName": "FOT-POS-Cashier-Setup-32bit.exe"
  },
  "asar": true
}
